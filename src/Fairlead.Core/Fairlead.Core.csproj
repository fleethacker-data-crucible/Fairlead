<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Fairlead ships this folder as SOURCE: the workstation blocks loading custom DLL files, so Windows PowerShell 5.1
      compiles these .cs files in memory at launch (Import-FairleadCore: Add-Type -Path ... -CompilerParameters), with
      the .NET Framework 4.8 CodeDom compiler. That compiler accepts C# 5 only, and the code may reference framework
      assemblies only (no NuGet packages, no third-party DLLs).

      This project exists to check exactly that on any machine: LangVersion 5, net48 reference assemblies, the same
      framework references as the launcher. Its DLL is never shipped or loaded. The tests compile the same files
      into Fairlead.Core.Tests.
    -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>5</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
    <AssemblyName>Fairlead.Core</AssemblyName>
    <RootNamespace>Fairlead.Core</RootNamespace>
    <!-- The release version. FairleadHost.Version must match (a test checks). -->
    <Version>0.1.0</Version>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Description>Fairlead model router core: OpenAI- and Anthropic-compatible gateway, routing, failover to local models, loopback host.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference assemblies only (compile-time); lets this build run without a .NET Framework targeting pack. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep in step with $FairleadCoreReferences in module\Fairlead\Fairlead.psm1. -->
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
  </ItemGroup>

</Project>
