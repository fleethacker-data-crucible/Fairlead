<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net48: loaded by Windows PowerShell 5.1 on the workstation (Add-Type -Path).
      netstandard2.0: consumed by the .NET 8 test project and by PowerShell 7.
      Both builds come from the same source; keep the API surface to what
      netstandard2.0 offers so the net48 build never drifts.
    -->
    <TargetFrameworks>net48;netstandard2.0</TargetFrameworks>
    <!-- C# 5: the workstation compiles this source at start with the inbox .NET Framework compiler (Add-Type). -->
    <LangVersion>5</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
    <AssemblyName>Fairlead.Core</AssemblyName>
    <RootNamespace>Fairlead.Core</RootNamespace>
    <Version>0.1.0</Version>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Description>Fairlead model router core: OpenAI- and Anthropic-compatible gateway, routing, failover to local models, loopback host.</Description>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Fairlead.Core.Tests" />
  </ItemGroup>

</Project>
